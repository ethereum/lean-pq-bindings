"""Python bindings for leanVM's leanXMSS and leanSPHINCS signatures and their aggregation."""

from collections.abc import Sequence
from typing import final

__all__ = [
    "__version__",
    "LeanPqError",
    "XmssSecretKey",
    "SphincsSecretKey",
    "Aggregate",
    "setup",
    "xmss_verify",
    "sphincs_verify",
    "aggregate",
]

__version__: str

class LeanPqError(Exception): ...

@final
class XmssSecretKey:
    @classmethod
    def generate(cls) -> "XmssSecretKey": ...
    @classmethod
    def from_seed(cls, seed: bytes) -> "XmssSecretKey": ...
    @classmethod
    def from_bytes(cls, data: bytes) -> "XmssSecretKey": ...
    def to_bytes(self) -> bytes: ...
    @property
    def public_key(self) -> bytes: ...
    def prepare(self, leaf_index: int) -> None: ...
    def sign(self, message: bytes, leaf_index: int) -> bytes: ...

@final
class SphincsSecretKey:
    @classmethod
    def generate(cls, kept_height: int) -> "SphincsSecretKey": ...
    @classmethod
    def from_seed(cls, seed: bytes, kept_height: int) -> "SphincsSecretKey": ...
    @classmethod
    def from_bytes(cls, data: bytes) -> "SphincsSecretKey": ...
    def to_bytes(self) -> bytes: ...
    @property
    def public_key(self) -> bytes: ...
    @property
    def kept_height(self) -> int: ...
    def sign(self, message: bytes) -> bytes: ...

@final
class Aggregate:
    @classmethod
    def from_bytes(cls, data: bytes) -> "Aggregate": ...
    def to_bytes(self) -> bytes: ...
    @property
    def xmss_claims(self) -> list[tuple[bytes, bytes]]: ...
    @property
    def sphincs_claims(self) -> list[tuple[bytes, bytes]]: ...

def setup() -> None: ...
def xmss_verify(public_key: bytes, message: bytes, signature: bytes) -> None: ...
def sphincs_verify(public_key: bytes, message: bytes, signature: bytes) -> None: ...
def aggregate(
    children: Sequence[Aggregate] = (),
    xmss: Sequence[tuple[bytes, bytes, bytes]] = (),
    sphincs: Sequence[tuple[bytes, bytes, bytes]] = (),
) -> Aggregate: ...
